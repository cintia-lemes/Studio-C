{
  "duration": 71.392653,
  "beats": [
    {
      "start": 0,
      "end": 1.396,
      "text": "\"Só hoje eu peço delivery.\""
    },
    {
      "start": 2.328,
      "end": 3.646,
      "text": "\"Só essa parcela não pesa.\""
    },
    {
      "start": 4.3,
      "end": 5.022,
      "text": "\"Só um cafezinho.\""
    },
    {
      "start": 5.62,
      "end": 6.577,
      "text": "Parece nada, né?"
    },
    {
      "start": 7.051,
      "end": 8.934,
      "text": "Mas o seu dinheiro não some de uma vez."
    },
    {
      "start": 9.328,
      "end": 10.036,
      "text": "Ele vaza."
    },
    {
      "start": 10.431,
      "end": 11.571,
      "text": "Gota por gota."
    },
    {
      "start": 11.977,
      "end": 12.805,
      "text": "Vamos fazer a conta."
    },
    {
      "start": 13.137,
      "end": 16.107,
      "text": "Um delivery de 35 reais, duas vezes por semana."
    },
    {
      "start": 16.422,
      "end": 17.767,
      "text": "São 70 por semana."
    },
    {
      "start": 18.055,
      "end": 20.758,
      "text": "No ano, mais de 3.600 reais."
    },
    {
      "start": 21.041,
      "end": 23.642,
      "text": "O lanchinho de 12 reais, todo dia de trabalho."
    },
    {
      "start": 23.931,
      "end": 25.666,
      "text": "Mais de 3.100 por ano."
    },
    {
      "start": 25.983,
      "end": 27.725,
      "text": "Aquelas três parcelas que não pesam..."
    },
    {
      "start": 28.009,
      "end": 31.242,
      "text": "89, 129 e 59 reais."
    },
    {
      "start": 31.433,
      "end": 34.061,
      "text": "Somadas, 277 por mês."
    },
    {
      "start": 34.259,
      "end": 36.293,
      "text": "Mais de 3.300 por ano."
    },
    {
      "start": 36.557,
      "end": 38.076,
      "text": "E as assinaturas que você nem usa."
    },
    {
      "start": 38.317,
      "end": 39.556,
      "text": "Mais 540."
    },
    {
      "start": 39.822,
      "end": 40.497,
      "text": "Junta tudo."
    },
    {
      "start": 40.761,
      "end": 42.656,
      "text": "Mais de 10 mil reais por ano."
    },
    {
      "start": 42.928,
      "end": 44.398,
      "text": "Pra quem ganha 3 mil por mês..."
    },
    {
      "start": 44.61,
      "end": 46.58,
      "text": "são mais de três salários inteiros."
    },
    {
      "start": 46.8,
      "end": 48.789,
      "text": "Saindo pelo ralo, sem você perceber."
    },
    {
      "start": 49.062,
      "end": 51.584,
      "text": "E o pior: nenhum desses gastos parece grande."
    },
    {
      "start": 51.776,
      "end": 53.023,
      "text": "Por isso ninguém sente."
    },
    {
      "start": 53.266,
      "end": 54.577,
      "text": "O problema não é o delivery."
    },
    {
      "start": 54.792,
      "end": 56.862,
      "text": "É o \"só hoje\" que vira toda semana."
    },
    {
      "start": 57.123,
      "end": 58.465,
      "text": "Você não precisa cortar tudo."
    },
    {
      "start": 58.709,
      "end": 59.7,
      "text": "Precisa enxergar."
    },
    {
      "start": 59.942,
      "end": 62.272,
      "text": "Anota seus pequenos gastos por 30 dias."
    },
    {
      "start": 62.471,
      "end": 63.834,
      "text": "Cancela o que você não usa."
    },
    {
      "start": 64.016,
      "end": 66.17,
      "text": "E escolhe um vazamento pra fechar este mês."
    },
    {
      "start": 66.404,
      "end": 68.758,
      "text": "Gota por gota... o pote também enche."
    },
    {
      "start": 69.01,
      "end": 71.193,
      "text": "Siga o perfil para mais conteúdos como este."
    }
  ]
}